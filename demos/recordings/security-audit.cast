[7.024, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;5;231m⏺\u001b[3G\u001b[39m\u001b[1mАудит безопасности перед релизом\u001b[22m\u001b[K\r\u001b[2B  \u001b[1mВердикт: выпускать нельзя.\u001b[22m Нашлось 3 критичных и 2 высоких проблемы, все пять я воспроизвёл локальными\u001b[K\r\u001b[1B  запросами.\u001b[14GСценарий:\u001b[24GAlice\u001b[30G(id\u001b[34G1)\u001b[37Gсоздаёт\u001b[45Gзаметку\u001b[53G3,\u001b[56Gатакует\u001b[64GBob\u001b[68G(id\u001b[72G2).\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BВсе ячейки «где» относятся к \u001b[38;5;153msrc/server.js\u001b[39m.\u001b[K\r\r\n\r\r\n\u001b[3G\u001b[1mважность:\u001b[13G\u001b[22mкритично\r\r\n\u001b[3G\u001b[1mгде:\u001b[8G\u001b[22m\u001b[38;5;153m:85-87\u001b[15G\u001b[39mGET\u001b[19G/api/notes/:id\r\r\n\u001b[3G\u001b[1mатака:\u001b[10G\u001b[22mНет\u001b[14Gпроверки\u001b[23Gвладельца:\u001b[34Gлюбой\u001b[40Gчитает\u001b[47Gчужую\u001b[53Gзаметку,\u001b[62Gперебирая\u001b[72Gid\u001b[75Gпо\u001b[78Gпорядку\r\r\n\u001b[3G\u001b[1mисправление:\u001b[16G\u001b[22m\u001b[38;5;153mnote.ownerId\u001b[29G!==\u001b[33Guser.id\u001b[41G\u001b[39m→"]
