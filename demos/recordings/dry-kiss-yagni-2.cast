[0.001, "o", "27GКомментарии\u001b[39Gв\u001b[41Gних\u001b[45Gобъясняют\u001b[55Gпричину.\r\r\n\r\r\n\u001b[3G\u001b[1mЕщё:\u001b[22m\r\r\n\u001b[3G-\u001b[5G\u001b[38;5;153msrc/dates.js:3\u001b[20G\u001b[39mи\u001b[22G\u001b[38;5;153m:8\u001b[39m:\u001b[26Gписьмо\u001b[33Gберёт\u001b[39Gдату\u001b[44Gв\u001b[46Gместном\u001b[54Gчасовом\u001b[62Gпоясе,\u001b[69Gа\u001b[71Gвыгрузка\u001b[80Gв\u001b[82GUTC.\u001b[87GУ\u001b[89Gзаказа\u001b[96Gоколо\u001b[102Gполуночи\r\r\n\u001b[5Gпо\u001b[8GМоскве\u001b[15Gдаты\u001b[20Gв\u001b[22Gписьме\u001b[29Gи\u001b[31Gв\u001b[33Gвыгрузке\u001b[42Gразойдутся.\u001b[54GЭто\u001b[58Gошибка\u001b[65Gкорректности,\u001b[79Gа\u001b[81Gне\u001b[84Gустройства\u001b[95Gкода.\u001b[101GСтанет\r\r\n\u001b[5Gактуальной\u001b[16Gвместе\u001b[23Gс\u001b[25Gвыгрузкой:\u001b[36Gсвязано\u001b[44Gс\u001b[46G#5.\r\r\n\u001b[3G-\u001b[5G\u001b[38;5;153msrc/receipt.js:3\u001b[39m:\u001b[23Gсумма\u001b[29Gстроки\u001b[36Gсчитается\u001b[46Gотдельно\u001b[55Gот\u001b[58G\u001b[38;5;153morderTotal\u001b[39m.\u001b[70GЭто\u001b[74Gдопустимо,\u001b[85Gкогда\u001b[91G#1\u001b[94Gбудет\u001b[100Gисправлен.\r\r\n\r"]
