[0.004, "o", "и,\u001b[57Gно\u001b[60Gменяются\u001b[69Gпо\u001b[72Gразным\u001b[79Gпричинам\u001b[88G(покупатель\u001b[100Gи\u001b[102Gпрограмма\r\r\n\u001b[5Gбухгалтерии).\u001b[19GЭто\u001b[23Gне\u001b[26Gдубль,\u001b[33Gобъединять\u001b[44Gне\u001b[47Gнадо.\r\r\n\r\r\n\u001b[3G\u001b[1mПередать:\u001b[13G\u001b[22m\u001b[38;5;153mtest/checkout.test.js:11\u001b[38G\u001b[39mзакрепляет\u001b[49Gневерную\u001b[58Gсумму\u001b[64G\u001b[38;5;153m/Итого:\u001b[72G247\u001b[76G₽/\u001b[39m,\u001b[80Gа\u001b[82Gотправку\u001b[91Gписьма\u001b[98Gникакой\u001b[106Gтест\r\r\n\u001b[3Gне\u001b[6Gпроверяет.\u001b[17GЭто\u001b[21Gдля\u001b[25G\u001b[38;5;153mtest-auditor\u001b[39m.\r\r\n\r\r\n\u001b[3GКакие\u001b[9Gпункты\u001b[16Gправить?\u001b[25GМожно\u001b[31Gвсе\u001b[35Gиз\u001b[38G«Править\u001b[47Gсейчас»,\u001b[56Gплюс\u001b[61Gскажите\u001b[69Gпо\u001b[72G№5\u001b[75Gи\u001b[77G№6.\u001b[81GПосле\u001b[87Gправок\u001b[94Gпрогоню\u001b[102Gтесты.\r\r\n\r\r\n\u001b[38;5;246m✻\u001b[3GBrewed\u001b[10Gfor\u001b[14G1m\u001b[17G43s\u001b[21G·\u001b[23Gdone\u001b[28G1:21\u001b[33Gam\u001b[39m\r\r\n\r\r\n\u001b[38;5;244m────────────"]
