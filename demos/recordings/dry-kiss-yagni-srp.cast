[2.898, "o", "\u001b[?25l\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;5;231m⏺\u001b[3G\u001b[39m\u001b[1mВердикт: сначала поправить.\u001b[22m Чек\u001b[35Gпоказывает\u001b[46Gне\u001b[49Gту\u001b[52Gсумму,\u001b[59Gчто\u001b[63Gписьмо,\u001b[71Gа\u001b[73Gтест\u001b[78Gзакрепляет\u001b[89Gневерный\u001b[98Gформат.\u001b[106GТесты\r\u001b[2C\u001b[1Bсейчас\u001b[10Gзелёные\u001b[18G(2/2).\u001b[25GВсе\u001b[29Gнаходки\u001b[37Gсубагента\u001b[47Gя\u001b[49Gсверил\u001b[56Gс\u001b[58Gкодом\u001b[64Gи\u001b[66Gпрогнал\u001b[74Gна\u001b[77Gзаказе\u001b[84G247,99\u001b[91G₽:\u001b[94Gчек\u001b[98Gвыдал\r\u001b[1B  «Итого: 248 ₽» и «Ложка x1: 1 ₽», письмо выдало «247,99 ₽».\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mПравить сейчас\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\r\n\u001b[3G\u001b[1m#:\u001b[6G\u001b[22m1\r\r\n\u001b[3G\u001b[1mfile:line:\u001b[14G\u001b[22m\u001b[38;5;153msrc/receipt.js:3,6\u001b[33G\u001b[39mvs\u001b[36G\u001b[38;5;153msrc/email.js:4\u001b[39m\r\r\n\u001b[3G\u001b[1mпринцип:\u001b[12G\u001b[22mDRY,\u001b[17Gкопии\u001b[23Gразошлись\r\r\n\u001b[3G\u001b[1mпроблема\u001b[12G→\u001b[14Gпредложение:\u001b[27G\u001b[22mЧек\u001b[31Gокругляет"]
[0.008, "o", "\u001b[41Gдо\u001b[44Gрублей,\u001b[52Gписьмо\u001b[59Gдаёт\u001b[64Gкопейки,\u001b[73Gа\u001b[75G\u001b[38;5;153mTASKS.md\u001b[84G\u001b[39mтребует\u001b[92G«247,99\u001b[100G₽».\u001b[104GНужна\r\r\n\u001b[3Gодна\u001b[8G\u001b[38;5;153mformatRub(kop)\u001b[23G\u001b[39mдля\u001b[27Gобоих,\u001b[34Gв\u001b[36Gтесте\u001b[42Gждать\u001b[48G«247,00\u001b[56G₽»\r\r\n\u001b[3G────────────────────────────────────────\r\r\n\u001b[3G\u001b[1m#:\u001b[6G\u001b[22m2\r\r\n\u001b[3G\u001b[1mfile:line:\u001b[14G\u001b[22m\u001b[38;5;153msrc/notify/index.js:1-29\u001b[39m\r\r\n\u001b[3G\u001b[1mпринцип:\u001b[12G\u001b[22mYAGNI/KISS\r\r\n\u001b[3G\u001b[1mпроблема\u001b[12G→\u001b[14Gпредложение:\u001b[27G\u001b[22mФабрика,\u001b[36Gбазовый\u001b[44Gкласс,\u001b[51Gтри\u001b[55Gпустых\u001b[62Gканала\u001b[69G(Sms,\u001b[75GPush,\u001b[81GTelegram)\u001b[91Gи\u001b[93G\u001b[38;5;153moptions\u001b[101G\u001b[39m(\u001b[38;5;153m:24\u001b[39m),\r\r\n\u001b[3Gкоторые\u001b[11Gникто\u001b[17Gне\u001b[20Gчитает.\u001b[28GЗаменить\u001b[37Gодной\u001b[43G\u001b[38;5;153msendEmail(to,\u001b[57Gsubject,\u001b[66Gtext)\u001b[39m\r\r\n\u001b[3G──────"]
[0.004, "o", "──────────────────────────────────\r\r\n\u001b[3G\u001b[1m#:\u001b[6G\u001b[22m3\r\r\n\u001b[3G\u001b[1mfile:line:\u001b[14G\u001b[22m\u001b[38;5;153msrc/dates.js:7\u001b[39m\r\r\n\u001b[3G\u001b[1mпринцип:\u001b[12G\u001b[22mYAGNI\r\r\n\u001b[3G\u001b[1mпроблема\u001b[12G→\u001b[14Gпредложение:\u001b[27G\u001b[22m\u001b[38;5;153mformatDateForExport\u001b[47G\u001b[39mнигде\u001b[53Gне\u001b[56Gвызывается.\u001b[68GУдалить\u001b[76Gи\u001b[78Gвернуть\u001b[86Gвместе\u001b[93Gс\u001b[95Gвыгрузкой.\r\r\n\u001b[3GЗаодно\r\r\n\u001b[3Gу\u001b[5Gнеё\u001b[9Gскрытый\u001b[17Gбаг:\u001b[22Gдата\u001b[27Gпо\u001b[30GUTC,\u001b[35Gа\u001b[37Gв\u001b[39Gписьме\u001b[46Gпо\u001b[49Gместному\u001b[58Gвремени.\u001b[67GЗаказ\u001b[73Gв\u001b[75G22:30\u001b[81GUTC\u001b[85Gв\u001b[87Gписьме\u001b[94Gбудет\u001b[100G«12\r\r\n\u001b[3Gноября»,\u001b[12Gв\u001b[14Gвыгрузке\u001b[23G2026-11-11\r\r\n\u001b[3G────────────────────────────────────────\r\r\n\u001b[3G\u001b[1m#:\u001b[6G\u001b[22m4\r\r\n\u001b[3G\u001b[1mfile:line:\u001b[14G\u001b[22m\u001b[38;5;153msrc/checkout.js:8\u001b[39m"]
[0.000, "o", "\r\r\n\u001b[3G\u001b[1mпринцип:\u001b[12G\u001b[22mимя\u001b[16Gврёт\r\r\n\u001b[3G\u001b[1mпроблема\u001b[12G→\u001b[14Gпредложение:\u001b[27G\u001b[22mНа\u001b[30Gадрес\u001b[36Gбез\u001b[40G«@»\u001b[44Gприходит\u001b[53G\u001b[38;5;153m'email\u001b[60Gis\u001b[63Grequired'\u001b[39m.\u001b[74GЗаменить\u001b[83Gна\u001b[86G\u001b[38;5;153m'invalid\u001b[95Gemail'\u001b[39m\r\r\n\r\r\n\u001b[3GПравка\u001b[10G№1\u001b[13Gменяет\u001b[20Gвид\u001b[24Gчека,\u001b[30Gно\u001b[33Gтолько\u001b[40Gприводит\u001b[49Gего\u001b[53Gк\u001b[55Gтребованию\u001b[66Gиз\u001b[69G\u001b[38;5;153mTASKS.md\u001b[39m,\u001b[79Gпоэтому\u001b[87Gона\u001b[91Gздесь,\u001b[98Gа\u001b[100Gне\u001b[103Gв\r\r\n\u001b[3Gвопросах\u001b[12Gк\u001b[14Gвам.\u001b[19GЕсли\u001b[24Gвыгрузка\u001b[33Gдля\u001b[37Gбухгалтерии\u001b[49Gещё\u001b[53Gвходит\u001b[60Gв\u001b[62G#9,\u001b[66Gв\u001b[68G№3\u001b[71Gвместо\u001b[78Gудаления\u001b[87Gнадо\u001b[92Gисправить\u001b[102Gчасовой\r\r\n\u001b[3Gпояс.\r\r\n\r\r\n\u001b[3G\u001b[1mРешать\u001b[10Gвам\u001b[22m\r\r\n\r\r\n\u001b[3G┌─────┬─────────────────────────┬───"]
[0.002, "o", "────────────────────────────────┬────────────────┬─────────────────┐\r\r\n\u001b[3G│\u001b[6G#\u001b[9G│\u001b[18Gfile:line\u001b[35G│\u001b[50Gвопрос\u001b[71G│\u001b[79Gза\u001b[88G│\u001b[94Gпротив\u001b[106G│\r\r\n\u001b[3G├─────┼─────────────────────────┼───────────────────────────────────┼────────────────┼─────────────────┤\r\r\n\u001b[3G│\u001b[9G│\u001b[35G│\u001b[37GПередавать\u001b[48Gотправку\u001b[57Gписьма\u001b[64Gи\u001b[71G│\u001b[73GТест\u001b[78Gсможет\u001b[88G│\u001b[90GОдин\u001b[95Gвызов,\u001b[106G│\r\r\n\u001b[3G│\u001b[5G5\u001b[9G│\u001b[11G\u001b[38;5;153msrc/checkout.js:18,21\u001b[35G\u001b[39m│\u001b[37Gтекущее\u001b[45Gвремя\u001b[51Gпараметрами:\u001b[71G│\u001b[73Gпроверить\u001b[88G│\u001b[90Gбаза\u001b[95Gв\u001b[97Gпамяти"]
